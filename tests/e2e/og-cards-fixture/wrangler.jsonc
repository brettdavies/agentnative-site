// Fixture Worker for the scorecard-card smoke. No routes here: scripts/og/smoke.sh attaches a fresh set of
// og-<kind>-<run>.anc.dev custom domains with `--domain` on each deploy and deletes the Worker afterwards.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "anc-og-fixtures",
  "main": "worker.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "preview_urls": false
}
