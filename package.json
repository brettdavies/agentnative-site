{
  "name": "agentnative-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "agentnative.dev — the agent-native CLI standard",
  "scripts": {
    "build": "bun src/build/build.mjs",
    "dev": "bun run build && wrangler dev -c wrangler.jsonc -c src/og-render/wrangler.jsonc --env staging --local --port 8787",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types ./src/worker-configuration.d.ts",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" && knip",
    "format": "biome format --write .",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dryrun": "bun run build && wrangler deploy --dry-run",
    "og": "bun scripts/og/generate.ts",
    "favicon": "bun scripts/favicon/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.61.1",
    "@types/accepts": "^1.3.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-playwright": "^2.2.2",
    "bun-types": "^1.4.0",
    "html-minifier-terser": "^7.2.0",
    "knip": "^6.42.1",
    "markdownlint-cli2": "^0.23.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/sandbox": "0.12.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@shikijs/rehype": "^4.5.0",
    "accepts": "^1.3.8",
    "agents": "^0.28.1",
    "badge-maker": "^6.0.0",
    "gifenc": "1.0.3",
    "js-yaml": "^5.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tldts": "^7.4.18",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "zod": "^4.6.7"
  }
}
