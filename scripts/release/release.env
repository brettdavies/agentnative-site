# Per-repo release values, sourced by scripts/release/_lib.sh. preflight,
# postflight and sync-dev are separate entry points, so a value declared in one
# script is missing from the other two; this file is the one place all three
# read.

# The deployed hosts preflight and postflight check when no --staging-url or
# --prod-url is given. Staging sits behind Cloudflare Access; both scripts read
# the service token themselves.
STAGING_URL_DEFAULT="https://agentnative-site-staging.brettdavies.workers.dev"
PROD_URL_DEFAULT="https://anc.dev"
