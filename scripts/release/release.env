# Per-repo release values, sourced by scripts/release/_lib.sh. preflight,
# postflight and sync-dev are separate entry points, so a value declared in one
# script is missing from the other two; this file is the one place all three
# read.

# The deployed hosts preflight and postflight check when no --staging-url or
# --prod-url is given. Staging sits behind Cloudflare Access; both scripts read
# the service token themselves.
STAGING_URL_DEFAULT="https://agentnative-site-staging.brettdavies.workers.dev"
PROD_URL_DEFAULT="https://anc.dev"

# The base of the site's deploy stamp `<base>.<epoch>-g<sha7>`, the site's
# major.minor (RELEASES.md § Versioning). A person raises it by hand, and it
# never goes down. With it set, step 4 of the release takes its version from
# site-version.sh, preflight checks the changelog heading with it, and the
# backport writes no package.json version.
SITE_VERSION_BASE="0.0"

# The files drift.sh gate 0 holds the previous release's backport to: its default
# list plus content/changelog.md. Each release writes that file, and a backport
# that leaves it off dev lets the next overlay erase the release's entry.
VERSION_CARRIERS="Cargo.toml package.json pyproject.toml VERSION CHANGELOG.md content/changelog.md"
