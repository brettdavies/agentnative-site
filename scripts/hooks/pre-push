#!/usr/bin/env bash
# Canonical version: 2026.11.03 (generic)
#
# Pre-push hook — mirrors .github/workflows/ci.yml so a green local push
# almost always means a green CI run. Saves the round-trip of pushing,
# watching CI fail on lint or a broken test, and force-pushing a fix.
#
# Activate once per clone:
#   git config core.hooksPath scripts/hooks
#
# Stages 1-5 and 9 mirror the CI workflow's gate job. CI does not run
# stages 6-8 and 10, so pre-push is their only enforcement:
#   1. lint           — biome check + markdownlint-cli2
#   2. typecheck      — tsc --noEmit over the client + worker projects
#   3. build          — bun src/build/build.mjs
#   4. tests          — bun test (unit + regression)
#   5. wrangler       — wrangler deploy --dry-run (config + bundle validation)
#   6. pack-README    — bun scripts/generate-pack-readme.mjs site --check
#                       (drift between styles/site/*.yml and the generated
#                       README; brand pack is vendored and not regenerated)
#   7. banned-fonts   — bash scripts/check-banned-fonts.sh
#                       (deployment-layer scan: CSS, TS, build scripts;
#                       reads tokens from styles/site/BannedFonts.yml)
#   8. shellcheck     — shellcheck --severity=warning over every tracked
#                       *.sh plus scripts/hooks/* (catches SC2034 / SC2086
#                       / SC2155 class bugs; skips with a one-line note
#                       when shellcheck isn't installed)
#   9. concurrency    — scripts/check-workflow-concurrency.sh
#                       (every workflow's concurrency group starts with a
#                       literal token, so a caller and a reusable it calls
#                       never share one)
#  10. prose-check    — bash scripts/prose-check.sh
#                       (Vale + LanguageTool over *.md in scope; LT skips
#                       cleanly when LanguageTool is unreachable)
#
# A push that only deletes, a push with no ref to update, and a tag or new
# branch at a commit the remote already has run nothing: none brings a commit
# for a stage to read.
#
# Stages 6-10 each redirect child stdin to </dev/null. push_only_deletes in
# scripts/hooks/_lib.sh consumes the hook-protocol ref lines from stdin; a
# child that read stdin would either swallow protocol bytes or fight for them.
#
# To bypass intentionally (rare): `git push --no-verify`. Don't make this
# a habit — the hook is here precisely to catch what we lost time to last.

set -euo pipefail

# From a linked worktree git exports GIT_DIR, which sends a tool's git calls in
# any directory to this repository, so a test that builds a scratch repository
# commits onto the pushed branch instead. Pre-push has no temporary index, and
# discovery from the hook's cwd (the worktree root) finds the same repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

cd "$(git rev-parse --show-toplevel)"
# shellcheck source=scripts/hooks/_lib.sh disable=SC1091
. ./scripts/hooks/_lib.sh || exit 1

if push_only_deletes; then
  echo "Nothing to check: the push only deletes."
  exit 0
fi

# A real push passes the remote's name and URL. With no ref lines after them,
# no ref would update. A hand run passes neither and checks everything.
if [ "$#" -ge 2 ] && [ -z "${HOOK_PUSH_REFS:-}" ]; then
  echo "pre-push: nothing to push"
  exit 0
fi

if push_only_known_commits "${1:-}"; then
  echo "Nothing to check: every pushed commit is already on $1."
  exit 0
fi

bold() { printf '\033[1m%s\033[0m\n' "$*"; }

# The dev-only prose stack (styles/, .vale.ini, scripts/prose-check.sh) is
# absent on main and on release/* branches cut from it, so the stages that
# consume it skip there. `[ -d styles ]` is the wrong presence test: any
# ignored stray inside the directory, a Finder .DS_Store being the one that
# actually happened, recreates it on a branch that tracks none of the tree, and
# the stage then runs against a pack that is not there and fails a release
# push. Test for the file the stage actually reads.
#
# Called with an unquoted glob: a pattern that matches nothing expands to
# itself, and that literal path does not exist.
have_glob() { [ -e "$1" ]; }

bold '==> bun run lint'
bun run lint

bold '==> bun run typecheck'
bun run typecheck

bold '==> bun run build'
bun run build

bold '==> bun test'
bun test

bold '==> bun x wrangler deploy --dry-run (production env)'
bun x wrangler deploy --dry-run --env=""

bold '==> bun x wrangler deploy --dry-run (staging env)'
bun x wrangler deploy --dry-run --env staging

bold '==> Pack-README drift check'
# Reads styles/site/*.yml, so that glob is the presence test.
if ! have_glob styles/site/*.yml; then
  echo "    WARN: styles/site/*.yml absent; skipping pack-README drift check (dev-only tooling)."
else
  bun scripts/generate-pack-readme.mjs site --check </dev/null
fi

bold '==> Banned-font deployment scan'
# Reads styles/site/BannedFonts.yml — the token list is that file.
if [ ! -f styles/site/BannedFonts.yml ] || [ ! -x scripts/check-banned-fonts.sh ]; then
  echo "    WARN: styles/site/BannedFonts.yml or scripts/check-banned-fonts.sh absent; skipping (dev-only tooling)."
else
  bash scripts/check-banned-fonts.sh </dev/null
fi

bold '==> shellcheck (severity=warning)'
# Lint every tracked *.sh plus the pre-push hook itself. Severity threshold
# "warning" catches real bugs (unused vars, quoting, missing exits) while
# ignoring info/style noise. Skip silently if shellcheck isn't installed —
# install via `brew install shellcheck` or `apt install shellcheck`.
if command -v shellcheck &>/dev/null; then
  mapfile -t shell_files < <({
    git ls-files '*.sh' 2>/dev/null
    git ls-files 'scripts/hooks/*' 2>/dev/null
  } | sort -u)
  if [ ${#shell_files[@]} -gt 0 ]; then
    shellcheck --severity=warning "${shell_files[@]}" </dev/null
  fi
else
  echo "  - shellcheck (skipped: install via \`brew install shellcheck\` or \`apt install shellcheck\`)"
fi

bold '==> workflow concurrency namespacing'
if [ -x scripts/check-workflow-concurrency.sh ]; then
  ./scripts/check-workflow-concurrency.sh </dev/null
else
  echo "  - skipped: scripts/check-workflow-concurrency.sh is not in this checkout"
fi

bold '==> prose-check (Vale + LanguageTool)'
# Vale resolves its rules through `StylesPath = styles` in .vale.ini, and the
# packs under styles/site/*.yml are what this repo adds on top. Contributor
# work happens on `dev`, where the whole stack is present.
if ! have_glob styles/site/*.yml || [ ! -f .vale.ini ] || [ ! -x scripts/prose-check.sh ]; then
  echo "    WARN: prose-check stack absent (styles/site/*.yml, .vale.ini, scripts/prose-check.sh)."
  echo "          This is normal on main and release/* branches; the stack is dev-only tooling. Skipping."
else
  # Scope to files changed vs PROSE_CHECK_BASE (default origin/dev) so untracked
  # or pre-existing prose drift outside the pushed branch's diff can't block the
  # push. Full-scope check remains available via `bash scripts/prose-check.sh`.
  bash scripts/prose-check.sh --changed-only </dev/null
fi

bold '==> pre-push checks passed'
